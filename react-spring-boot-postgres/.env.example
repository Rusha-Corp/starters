# ── Common ────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ── API (Spring Boot) ────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/rusha
SPRING_DATASOURCE_USERNAME=rusha
SPRING_DATASOURCE_PASSWORD=rusha
SPRING_RABBITMQ_HOST=queue
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=rusha
SPRING_RABBITMQ_PASSWORD=rusha

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=rusha
POSTGRES_PASSWORD=rusha
POSTGRES_DB=rusha

# ── Queue (RabbitMQ) ─────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=rusha
RABBITMQ_DEFAULT_PASS=rusha
