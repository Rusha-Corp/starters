# ── Common ────────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ── API (Quarkus) ────────────────────────────────────────────────────────────
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://db:5432/rusha
QUARKUS_DATASOURCE_USERNAME=rusha
QUARKUS_DATASOURCE_PASSWORD=rusha
KAFKA_BOOTSTRAP_SERVERS=queue:9092

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=rusha
POSTGRES_PASSWORD=rusha
POSTGRES_DB=rusha

# ── Queue (Kafka) ─────────────────────────────────────────────────────────────
KAFKA_CFG_NODE_ID=0
KAFKA_CFG_PROCESS_ROLES=broker,controller
KAFKA_CFG_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_CFG_ADVERTISED_LISTENERS=PLAINTEXT://queue:9092
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@queue:9093
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
ALLOW_PLAINTEXT_LISTENER=yes
